# name: test/sql/read_lines_uri_specs_posix.test
# description: URI-safe line specs on paths that contain ':' (POSIX-only file names)
# group: [sql]

require read_lines

# ':' is not a legal file name character on Windows, so the colon-bearing paths
# below can only be materialised on POSIX platforms. The parsing they exercise
# is platform-independent.
require notwindows

# A locator that is shaped like a VFS URI ("scheme:opaque@ref"). This is the
# case from issue #8: the ':' line-spec suffix cannot be used here without
# guessing which colon is the scheme separator, while the '#L' fragment is
# separable by definition.
statement ok
COPY (SELECT unnest(['alpha', 'beta', 'gamma', 'delta', 'epsilon']) AS l)
TO '__TEST_DIR__/vcs:SCHEMAS.md@HEAD' (FORMAT csv, HEADER false);

# No spec: reads the whole file (this already worked)
query I
SELECT count(*) FROM read_lines('__TEST_DIR__/vcs:SCHEMAS.md@HEAD');
----
5

# Fragment spec on the same colon-bearing locator
query II
SELECT line_number, rtrim(content, chr(10) || chr(13))
FROM read_lines('__TEST_DIR__/vcs:SCHEMAS.md@HEAD#L2-L3');
----
2	beta
3	gamma

# Qualifier spec on the same colon-bearing locator
query II
SELECT line_number, rtrim(content, chr(10) || chr(13))
FROM read_lines('__TEST_DIR__/vcs:SCHEMAS.md@HEAD;lines=4');
----
4	delta

# RFC 3986 3.4: the query comes before the fragment and stays on the locator.
# The file name here really contains "?token=abc", so this only resolves if
# ';lines=2' was removed from the path component and the query was kept.
statement ok
COPY (SELECT unnest(['alpha', 'beta', 'gamma']) AS l)
TO '__TEST_DIR__/vcs:SCHEMAS.md?token=abc' (FORMAT csv, HEADER false);

query II
SELECT line_number, rtrim(content, chr(10) || chr(13))
FROM read_lines('__TEST_DIR__/vcs:SCHEMAS.md;lines=2?token=abc');
----
2	beta
